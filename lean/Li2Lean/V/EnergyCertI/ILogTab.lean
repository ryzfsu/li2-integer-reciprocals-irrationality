def NLT : Nat := 24

/-- Exact `(lpoly q n - lrem q n, lpoly q n + lrem q n)` at `q = (256+j)/256`. -/
def logTabBounds (j : Nat) : QF × QF :=
  let H := hornerQ (Int.ofNat (j * j)) ((512 + j) * (512 + j)) 0 NLT
  let lp : QF := (2 * Int.ofNat j * H.1, (512 + j) * H.2)
  let lr : QF := (Int.ofNat (2 * j ^ (2 * NLT + 1)),
    (512 + j) ^ (2 * NLT - 1) * ((512 + j) * (512 + j) - j * j))
  (qsub lp lr, qadd lp lr)

def ivContains (I : IV) (b : QF × QF) : Bool := qle (I.1, S) b.1 && qle b.2 (I.2, S)

def logTabRowOK (r : Nat) : Bool :=
