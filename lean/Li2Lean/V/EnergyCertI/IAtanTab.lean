/-- `π/2` from P0 `PI` (`314159265358979323846/10^20 ..847/10^20`). -/
def halfPiI : IV := (28976077832308491369, 28976077832308491370)

def NATN : Nat := 14

/-- Numerators of P0 `atTab k` over `10^21`. -/
def atNum : Nat → Int × Int
  | 0 => (0, 0)
  | 1 => (244978663126864154172, 244978663126864154174)
  | 2 => (463647609000806116214, 463647609000806116215)
  | _ => (643501108793284386802, 643501108793284386803)

def atanTabBounds (j : Nat) : QF × QF :=
  let k := min 3 ((j + 32) / 64)
  let vn : Int := 4 * Int.ofNat j - 256 * Int.ofNat k
  let vd : Nat := 1024 + j * k
  let H := hornerQ (-(vn * vn)) (vd * vd) 0 NATN
  let spr : QF := (vn * H.1, vd * H.2)
  let srem : QF := (Int.ofNat (vn.natAbs ^ (2 * NATN + 1)), (2 * NATN + 1) * vd ^ (2 * NATN + 1))
  (qsub (qadd ((atNum k).1, 1000000000000000000000) spr) srem,
   qadd (qadd ((atNum k).2, 1000000000000000000000) spr) srem)

def atanTabRowOK (r : Nat) : Bool :=
  (List.range (if r = 16 then 1 else 16)).all fun c =>
    ivContains (tabGet atanTab (16 * r + c)) (atanTabBounds (16 * r + c))

