theorem q4rz_hsrc : ∀ r c : Fin 9,
    (V.vSourceMatrix 1 (-((4 : ℕ) : ℤ)) r c).eval 0 = q4SourceMatrixAtZeroExplicit r c := by
  intro r c
  -- VERIFIED (master 7d5cd808): `q4SourceMatrixAtZero : Matrix (Fin 9) (Fin 9) ℚ :=
  -- fun r c => (V.vSourceMatrix 1 (-4 : ℤ) r c).eval 0` and
  -- `q4_source_eq_explicit : q4SourceMatrixAtZero = q4SourceMatrixAtZeroExplicit`.
  -- FIXED: definitional alternative (`-((4 : ℕ) : ℤ)` and `(-4 : ℤ)` are both
  -- `Int.negSucc 3` after whnf).
  first
    | (rw [show (-((4 : ℕ) : ℤ)) = (-4 : ℤ) by norm_num]
       exact congrFun (congrFun q4_source_eq_explicit r) c)
    | exact congrFun (congrFun q4_source_eq_explicit r) c

theorem q4rz_hN0 : ∀ r c : Fin 9,
    (q4rzD r : ℚ) * q4SourceMatrixAtZeroExplicit r c = (q4rzN0 r c : ℚ) := by
  intro r c
  fin_cases r <;> fin_cases c <;>
    norm_num [q4rzD, q4rzN0, q4SourceMatrixAtZeroExplicit]

theorem q4rz_hAN : ∀ r c : Fin 9,
    (q4rzD r : ℚ) * seedAEntry (-((4 : ℕ) : ℤ)) r c = (q4rzAN r c : ℚ) := by
  intro r c
  -- VERIFIED: same shape as `q4_source_eq_explicit` (a `Fin 9` literal read
  -- at `Fin (V.vMatrixSize 1)`; `Fin.val ⟨k, _⟩` reduces by projection).
  -- `V.vAEntry a i j := if i = j then (a : ℚ) ^ i else 0` (`V/VFamily.lean:90`).
  -- FIXED: the planned alternative runs automatically.
  fin_cases r <;> fin_cases c <;>
    first
      | (norm_num [q4rzD, q4rzAN, seedAEntry, V.vAEntry, V.vMatrixSize, V.vM, V.vS]; done)
      | (simp [q4rzD, q4rzAN, seedAEntry, V.vAEntry] <;> norm_num)

/-- `∏ r, q4rzD r ≡ 1 (mod 23)`, inverse `1`. -/
def q4rzDinv : ZMod (vSeedPrime 4) := 1

theorem q4rz_hDinv : ((∏ r, q4rzD r : ℕ) : ZMod (vSeedPrime 4)) * q4rzDinv = 1 := by
  -- VERIFIED: `decide` in `ZMod (vSeedPrime N)` with large literals is a master
  -- pattern (`Q2ActualSeedResidueProof.q2_inv_constant`, literal 2333772000000000).
  -- FIXED: alternatives run automatically.
  first
    | decide
    | decide +kernel
    | (simp only [Fin.prod_univ_succ, Fin.prod_univ_zero, q4rzD, q4rzDinv]
       decide)

-- VERIFIED: `left_ne_zero_of_mul_eq_one [MulZeroOneClass M₀] [Nontrivial M₀]
-- (h : a * b = 1) : a ≠ 0` (`Algebra/GroupWithZero/Basic.lean:136`).
theorem q4rz_hD : ((∏ r, q4rzD r : ℕ) : ZMod (vSeedPrime 4)) ≠ 0 :=
  left_ne_zero_of_mul_eq_one q4rz_hDinv

