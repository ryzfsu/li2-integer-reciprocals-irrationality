theorem q4rz_LU4 : q4rzE * q4rzNbar4 = q4rzL4 * q4rzU4 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    first
      | decide +kernel
      | (norm_num [q4rzE, q4rzNbar4, q4rzL4, q4rzU4, Matrix.mul_apply, Fin.sum_univ_succ] <;>
          decide)

theorem q4rz_L4_det : q4rzL4.det = 1 := by
  rw [Matrix.det_of_isLowerTriangular q4rzL4 (by first | decide | decide +kernel)]
  first
    | decide
    | decide +kernel

theorem q4rz_U4_det : q4rzU4.det = 18 := by
  rw [Matrix.det_of_isUpperTriangular (M := q4rzU4) (by first | decide | decide +kernel)]
  first
    | decide
    | decide +kernel

theorem q4rz_point4 :
    seedEvalRes 4 4 * ((∏ r, q4rzD r : ℕ) : ZMod (vSeedPrime 4)) = 18 :=
  seed_point_residue q4SourceMatrixAtZeroExplicit q4rz_hsrc q4rzD q4rzN0 q4rzAN
    q4rz_hN0 q4rz_hAN q4rz_hD 4 q4rzE q4rzNbar4 q4rzL4 q4rzU4 q4rz_Nbar4 q4rz_E_det
    q4rz_LU4 q4rz_L4_det 18 q4rz_U4_det

/-! ## 4. Inverse Vandermonde modulo 23 and the residue row -/

def q4rzW : Matrix (Fin 5) (Fin 5) (ZMod (vSeedPrime 4)) := !![
  1, 0, 0, 0, 0;
  19, 4, 20, 9, 17;
  12, 11, 22, 13, 11;
  13, 13, 21, 5, 17;
  1, 19, 6, 19, 1]

-- VERIFIED: the entries `((t : ℕ) : ZMod p) ^ j` use `Fin.npow`, i.e. core
-- `Nat.powMod` (`@[semireducible]`, documented to reduce under `decide`);
-- master precedent `(2 : ZMod 11) ^ 2 * 3 = 1` by `decide` (`V/NegativeTwoSeed`).
-- FIXED: `norm_num` alternative evaluates the powers without `Nat.powMod`.
theorem q4rz_hW : q4rzW * seedVandermonde (vSeedPrime 4) = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    first
      | decide
      | decide +kernel
      | (norm_num [q4rzW, seedVandermonde, Matrix.mul_apply, Matrix.one_apply,
          Fin.sum_univ_succ] <;> decide)

-- VERIFIED: `vSeedResidueRow` is a literal match on `(q, ⟨k, _⟩)`
-- (`B3/ActualFrobeniusProducer.lean:57`); master decides it in
-- `vSeedResidueRow_lt_prime`.
theorem q4rz_hrow : Matrix.mulVec q4rzW ![5 * q4rzDinv, 1 * q4rzDinv, 21 * q4rzDinv, 14 * q4rzDinv, 18 * q4rzDinv] =
    fun i => (vSeedResidueRow 4 i : ZMod (vSeedPrime 4)) := by
  funext i
  fin_cases i <;> first | decide | decide +kernel
  -- values: W * e = [5, 8, 16, 21, 20], e = [5, 1, 21, 14, 18].

theorem q4_row_residue_zmod : ∀ i : Fin 5,
    vSeedCoeffResidue 4 i.val = (vSeedResidueRow 4 i : ZMod (vSeedPrime 4)) :=
  vSeedRowResidue_of_zmod (q := 4) (by first | norm_num [vSeedPrime] | decide)
    ((∏ r, q4rzD r : ℕ) : ZMod (vSeedPrime 4)) q4rzDinv q4rz_hDinv
    5 1 21 14 18
    q4rz_point0 q4rz_point1 q4rz_point2 q4rz_point3 q4rz_point4 q4rzW q4rz_hW q4rz_hrow

end
