theorem q7rz_LU4 : q7rzE * q7rzNbar4 = q7rzL4 * q7rzU4 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    first
      | decide +kernel
      | (norm_num [q7rzE, q7rzNbar4, q7rzL4, q7rzU4, Matrix.mul_apply, Fin.sum_univ_succ] <;>
          decide)

theorem q7rz_L4_det : q7rzL4.det = 1 := by
  rw [Matrix.det_of_isLowerTriangular q7rzL4 (by first | decide | decide +kernel)]
  first
    | decide
