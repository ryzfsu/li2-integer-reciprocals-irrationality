theorem q7rz_hsrc : ∀ r c : Fin 9,
    (V.vSourceMatrix 1 (-((7 : ℕ) : ℤ)) r c).eval 0 = q7SourceMatrixAtZeroExplicit r c := by
  intro r c
  -- VERIFIED (master 7d5cd808): `q7SourceMatrixAtZero : Matrix (Fin 9) (Fin 9) ℚ :=
  -- fun r c => (V.vSourceMatrix 1 (-7 : ℤ) r c).eval 0` and
  -- `q7_source_eq_explicit : q7SourceMatrixAtZero = q7SourceMatrixAtZeroExplicit`.
  -- FIXED: definitional alternative (`-((7 : ℕ) : ℤ)` and `(-7 : ℤ)` are both
  -- `Int.negSucc 6` after whnf).
  first
    | (rw [show (-((7 : ℕ) : ℤ)) = (-7 : ℤ) by norm_num]
       exact congrFun (congrFun q7_source_eq_explicit r) c)
    | exact congrFun (congrFun q7_source_eq_explicit r) c

