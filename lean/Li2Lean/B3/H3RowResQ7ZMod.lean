theorem q7rz_U4_det : q7rzU4.det = 8 := by
  rw [Matrix.det_of_isUpperTriangular (M := q7rzU4) (by first | decide | decide +kernel)]
  first
    | decide
    | decide +kernel

theorem q7rz_point4 :
    seedEvalRes 7 4 * ((∏ r, q7rzD r : ℕ) : ZMod (vSeedPrime 7)) = 8 :=
  seed_point_residue q7SourceMatrixAtZeroExplicit q7rz_hsrc q7rzD q7rzN0 q7rzAN
    q7rz_hN0 q7rz_hAN q7rz_hD 4 q7rzE q7rzNbar4 q7rzL4 q7rzU4 q7rz_Nbar4 q7rz_E_det
    q7rz_LU4 q7rz_L4_det 8 q7rz_U4_det

/-! ## 4. Inverse Vandermonde modulo 17 and the residue row -/

def q7rzW : Matrix (Fin 5) (Fin 5) (ZMod (vSeedPrime 7)) := !![
  1, 0, 0, 0, 0;
  5, 4, 14, 7, 4;
  5, 7, 9, 9, 4;
  1, 10, 15, 4, 4;
  5, 14, 13, 14, 5]

-- VERIFIED: the entries `((t : ℕ) : ZMod p) ^ j` use `Fin.npow`, i.e. core
-- `Nat.powMod` (`@[semireducible]`, documented to reduce under `decide`);
-- master precedent `(2 : ZMod 11) ^ 2 * 3 = 1` by `decide` (`V/NegativeTwoSeed`).
-- FIXED: `norm_num` alternative evaluates the powers without `Nat.powMod`.
theorem q7rz_hW : q7rzW * seedVandermonde (vSeedPrime 7) = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    first
      | decide
      | decide +kernel
      | (norm_num [q7rzW, seedVandermonde, Matrix.mul_apply, Matrix.one_apply,
          Fin.sum_univ_succ] <;> decide)

-- VERIFIED: `vSeedResidueRow` is a literal match on `(q, ⟨k, _⟩)`
-- (`B3/ActualFrobeniusProducer.lean:57`); master decides it in
-- `vSeedResidueRow_lt_prime`.
theorem q7rz_hrow : Matrix.mulVec q7rzW ![9 * q7rzDinv, 14 * q7rzDinv, 7 * q7rzDinv, 1 * q7rzDinv, 8 * q7rzDinv] =
    fun i => (vSeedResidueRow 7 i : ZMod (vSeedPrime 7)) := by
  funext i
  fin_cases i <;> first | decide | decide +kernel
  -- values: W * e = [8, 0, 8, 16, 5], e = [8, 3, 10, 16, 9].

theorem q7_row_residue_zmod : ∀ i : Fin 5,
    vSeedCoeffResidue 7 i.val = (vSeedResidueRow 7 i : ZMod (vSeedPrime 7)) :=
  vSeedRowResidue_of_zmod (q := 7) (by first | norm_num [vSeedPrime] | decide)
    ((∏ r, q7rzD r : ℕ) : ZMod (vSeedPrime 7)) q7rzDinv q7rz_hDinv
    9 14 7 1 8
    q7rz_point0 q7rz_point1 q7rz_point2 q7rz_point3 q7rz_point4 q7rzW q7rz_hW q7rz_hrow

end
