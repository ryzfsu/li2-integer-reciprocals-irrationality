    (q7rzD r : ℚ) * seedAEntry (-((7 : ℕ) : ℤ)) r c = (q7rzAN r c : ℚ) := by
  intro r c
  -- VERIFIED: same shape as `q7_source_eq_explicit` (a `Fin 9` literal read
  -- at `Fin (V.vMatrixSize 1)`; `Fin.val ⟨k, _⟩` reduces by projection).
  -- `V.vAEntry a i j := if i = j then (a : ℚ) ^ i else 0` (`V/VFamily.lean:90`).
  -- FIXED: the planned alternative runs automatically.
  fin_cases r <;> fin_cases c <;>
    first
      | (norm_num [q7rzD, q7rzAN, seedAEntry, V.vAEntry, V.vMatrixSize, V.vM, V.vS]; done)
      | (simp [q7rzD, q7rzAN, seedAEntry, V.vAEntry] <;> norm_num)

