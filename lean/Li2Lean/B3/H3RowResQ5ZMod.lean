theorem q5rz_hsrc : ∀ r c : Fin 9,
    (V.vSourceMatrix 1 (-((5 : ℕ) : ℤ)) r c).eval 0 = q5SourceMatrixAtZeroExplicit r c := by
  intro r c
  -- VERIFIED (master 7d5cd808): `q5SourceMatrixAtZero : Matrix (Fin 9) (Fin 9) ℚ :=
  -- fun r c => (V.vSourceMatrix 1 (-5 : ℤ) r c).eval 0` and
  -- `q5_source_eq_explicit : q5SourceMatrixAtZero = q5SourceMatrixAtZeroExplicit`.
  -- FIXED: definitional alternative (`-((5 : ℕ) : ℤ)` and `(-5 : ℤ)` are both
  -- `Int.negSucc 4` after whnf).
  first
    | (rw [show (-((5 : ℕ) : ℤ)) = (-5 : ℤ) by norm_num]
       exact congrFun (congrFun q5_source_eq_explicit r) c)
    | exact congrFun (congrFun q5_source_eq_explicit r) c

theorem q5rz_hN0 : ∀ r c : Fin 9,
    (q5rzD r : ℚ) * q5SourceMatrixAtZeroExplicit r c = (q5rzN0 r c : ℚ) := by
  intro r c
  fin_cases r <;> fin_cases c <;>
    norm_num [q5rzD, q5rzN0, q5SourceMatrixAtZeroExplicit]

theorem q5rz_hAN : ∀ r c : Fin 9,
    (q5rzD r : ℚ) * seedAEntry (-((5 : ℕ) : ℤ)) r c = (q5rzAN r c : ℚ) := by
  intro r c
  -- VERIFIED: same shape as `q5_source_eq_explicit` (a `Fin 9` literal read
  -- at `Fin (V.vMatrixSize 1)`; `Fin.val ⟨k, _⟩` reduces by projection).
  -- `V.vAEntry a i j := if i = j then (a : ℚ) ^ i else 0` (`V/VFamily.lean:90`).
  -- FIXED: the planned alternative runs automatically.
  fin_cases r <;> fin_cases c <;>
    first
      | (norm_num [q5rzD, q5rzAN, seedAEntry, V.vAEntry, V.vMatrixSize, V.vM, V.vS]; done)
      | (simp [q5rzD, q5rzAN, seedAEntry, V.vAEntry] <;> norm_num)

/-- `∏ r, q5rzD r ≡ 4 (mod 11)`, inverse `3`. -/
def q5rzDinv : ZMod (vSeedPrime 5) := 3

theorem q5rz_hDinv : ((∏ r, q5rzD r : ℕ) : ZMod (vSeedPrime 5)) * q5rzDinv = 1 := by
  -- VERIFIED: `decide` in `ZMod (vSeedPrime N)` with large literals is a master
  -- pattern (`Q2ActualSeedResidueProof.q2_inv_constant`, literal 2333772000000000).
  -- FIXED: alternatives run automatically.
  first
    | decide
    | decide +kernel
    | (simp only [Fin.prod_univ_succ, Fin.prod_univ_zero, q5rzD, q5rzDinv]
       decide)

-- VERIFIED: `left_ne_zero_of_mul_eq_one [MulZeroOneClass M₀] [Nontrivial M₀]
-- (h : a * b = 1) : a ≠ 0` (`Algebra/GroupWithZero/Basic.lean:136`).
theorem q5rz_hD : ((∏ r, q5rzD r : ℕ) : ZMod (vSeedPrime 5)) ≠ 0 :=
