theorem q2rz_hsrc : ∀ r c : Fin 9,
    (V.vSourceMatrix 1 (-((2 : ℕ) : ℤ)) r c).eval 0 = q2SourceMatrixAtZeroExplicit r c := by
  intro r c
  -- VERIFIED (master 7d5cd808): `q2SourceMatrixAtZero : Matrix (Fin 9) (Fin 9) ℚ :=
  -- fun r c => (V.vSourceMatrix 1 (-2 : ℤ) r c).eval 0` and
  -- `q2_source_eq_explicit : q2SourceMatrixAtZero = q2SourceMatrixAtZeroExplicit`.
  -- FIXED: definitional alternative (`-((2 : ℕ) : ℤ)` and `(-2 : ℤ)` are both
  -- `Int.negSucc 1` after whnf).
  first
    | (rw [show (-((2 : ℕ) : ℤ)) = (-2 : ℤ) by norm_num]
       exact congrFun (congrFun q2_source_eq_explicit r) c)
    | exact congrFun (congrFun q2_source_eq_explicit r) c

theorem q2rz_hN0 : ∀ r c : Fin 9,
    (q2rzD r : ℚ) * q2SourceMatrixAtZeroExplicit r c = (q2rzN0 r c : ℚ) := by
  intro r c
  fin_cases r <;> fin_cases c <;>
    norm_num [q2rzD, q2rzN0, q2SourceMatrixAtZeroExplicit]

theorem q2rz_hAN : ∀ r c : Fin 9,
    (q2rzD r : ℚ) * seedAEntry (-((2 : ℕ) : ℤ)) r c = (q2rzAN r c : ℚ) := by
  intro r c
  -- VERIFIED: same shape as `q2_source_eq_explicit` (a `Fin 9` literal read
  -- at `Fin (V.vMatrixSize 1)`; `Fin.val ⟨k, _⟩` reduces by projection).
  -- `V.vAEntry a i j := if i = j then (a : ℚ) ^ i else 0` (`V/VFamily.lean:90`).
  -- FIXED: the planned alternative runs automatically.
  fin_cases r <;> fin_cases c <;>
    first
      | (norm_num [q2rzD, q2rzAN, seedAEntry, V.vAEntry, V.vMatrixSize, V.vM, V.vS]; done)
      | (simp [q2rzD, q2rzAN, seedAEntry, V.vAEntry] <;> norm_num)

/-- `∏ r, q2rzD r ≡ 10 (mod 11)`, inverse `10`. -/
def q2rzDinv : ZMod (vSeedPrime 2) := 10

theorem q2rz_hDinv : ((∏ r, q2rzD r : ℕ) : ZMod (vSeedPrime 2)) * q2rzDinv = 1 := by
  -- VERIFIED: `decide` in `ZMod (vSeedPrime N)` with large literals is a master
  -- pattern (`Q2ActualSeedResidueProof.q2_inv_constant`, literal 2333772000000000).
  -- FIXED: alternatives run automatically.
  first
    | decide
    | decide +kernel
    | (simp only [Fin.prod_univ_succ, Fin.prod_univ_zero, q2rzD, q2rzDinv]
       decide)

-- VERIFIED: `left_ne_zero_of_mul_eq_one [MulZeroOneClass M₀] [Nontrivial M₀]
-- (h : a * b = 1) : a ≠ 0` (`Algebra/GroupWithZero/Basic.lean:136`).
theorem q2rz_hD : ((∏ r, q2rzD r : ℕ) : ZMod (vSeedPrime 2)) ≠ 0 :=
