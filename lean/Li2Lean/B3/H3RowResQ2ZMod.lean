  6, 4, 3, 9, 2, 8, 7, 5, 10]

def q2rzL4 : Matrix (Fin 9) (Fin 9) (ZMod (vSeedPrime 2)) := !![
  1, 0, 0, 0, 0, 0, 0, 0, 0;
  3, 1, 0, 0, 0, 0, 0, 0, 0;
  5, 4, 1, 0, 0, 0, 0, 0, 0;
  10, 1, 4, 1, 0, 0, 0, 0, 0;
  2, 5, 3, 10, 1, 0, 0, 0, 0;
  2, 6, 0, 8, 2, 1, 0, 0, 0;
  5, 5, 1, 7, 1, 0, 1, 0, 0;
  7, 9, 8, 6, 9, 9, 1, 1, 0;
  10, 2, 9, 7, 7, 6, 5, 7, 1]

def q2rzU4 : Matrix (Fin 9) (Fin 9) (ZMod (vSeedPrime 2)) := !![
  5, 4, 5, 8, 4, 0, 7, 9, 5;
  0, 4, 7, 10, 4, 1, 8, 6, 9;
  0, 0, 3, 8, 6, 8, 8, 5, 5;
  0, 0, 0, 5, 4, 3, 7, 2, 4;
  0, 0, 0, 0, 10, 5, 8, 5, 4;
