theorem q2rz_Nbar4 : ∀ i j : Fin 9,
    ((q2rzN0 i j - ((4 : ℕ) : ℤ) * q2rzAN i j : ℤ) : ZMod (vSeedPrime 2)) = q2rzNbar4 i j := by
  intro i j
  fin_cases i <;> fin_cases j <;> first | decide | decide +kernel

-- FIXED: per-entry `decide +kernel` (one 9-term dot product in `Fin p` per
-- goal, no `norm_num` proof term); original `norm_num ... <;> decide` kept as
-- the alternative alternative.
theorem q2rz_LU4 : q2rzE * q2rzNbar4 = q2rzL4 * q2rzU4 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    first
      | decide +kernel
      | (norm_num [q2rzE, q2rzNbar4, q2rzL4, q2rzU4, Matrix.mul_apply, Fin.sum_univ_succ] <;>
          decide)

theorem q2rz_L4_det : q2rzL4.det = 1 := by
  rw [Matrix.det_of_isLowerTriangular q2rzL4 (by first | decide | decide +kernel)]
  first
    | decide
    | decide +kernel

theorem q2rz_U4_det : q2rzU4.det = 9 := by
  rw [Matrix.det_of_isUpperTriangular (M := q2rzU4) (by first | decide | decide +kernel)]
  first
    | decide
    | decide +kernel

theorem q2rz_point4 :
    seedEvalRes 2 4 * ((∏ r, q2rzD r : ℕ) : ZMod (vSeedPrime 2)) = 9 :=
  seed_point_residue q2SourceMatrixAtZeroExplicit q2rz_hsrc q2rzD q2rzN0 q2rzAN
    q2rz_hN0 q2rz_hAN q2rz_hD 4 q2rzE q2rzNbar4 q2rzL4 q2rzU4 q2rz_Nbar4 q2rz_E_det
    q2rz_LU4 q2rz_L4_det 9 q2rz_U4_det

/-! ## 4. Inverse Vandermonde modulo 11 and the residue row -/

def q2rzW : Matrix (Fin 5) (Fin 5) (ZMod (vSeedPrime 2)) := !![
  1, 0, 0, 0, 0;
  8, 4, 8, 5, 8;
  1, 3, 2, 5, 0;
  6, 7, 9, 3, 8;
  6, 9, 3, 9, 6]

-- VERIFIED: the entries `((t : ℕ) : ZMod p) ^ j` use `Fin.npow`, i.e. core
-- `Nat.powMod` (`@[semireducible]`, documented to reduce under `decide`);
-- master precedent `(2 : ZMod 11) ^ 2 * 3 = 1` by `decide` (`V/NegativeTwoSeed`).
-- FIXED: `norm_num` alternative evaluates the powers without `Nat.powMod`.
theorem q2rz_hW : q2rzW * seedVandermonde (vSeedPrime 2) = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    first
      | decide
      | decide +kernel
      | (norm_num [q2rzW, seedVandermonde, Matrix.mul_apply, Matrix.one_apply,
          Fin.sum_univ_succ] <;> decide)

-- VERIFIED: `vSeedResidueRow` is a literal match on `(q, ⟨k, _⟩)`
-- (`B3/ActualFrobeniusProducer.lean:57`); master decides it in
-- `vSeedResidueRow_lt_prime`.
theorem q2rz_hrow : Matrix.mulVec q2rzW ![7 * q2rzDinv, 8 * q2rzDinv, 5 * q2rzDinv, 8 * q2rzDinv, 9 * q2rzDinv] =
    fun i => (vSeedResidueRow 2 i : ZMod (vSeedPrime 2)) := by
  funext i
  fin_cases i <;> first | decide | decide +kernel
  -- values: W * e = [4, 2, 7, 3, 9], e = [4, 3, 6, 3, 2].

theorem q2_row_residue_zmod : ∀ i : Fin 5,
    vSeedCoeffResidue 2 i.val = (vSeedResidueRow 2 i : ZMod (vSeedPrime 2)) :=
  vSeedRowResidue_of_zmod (q := 2) (by first | norm_num [vSeedPrime] | decide)
    ((∏ r, q2rzD r : ℕ) : ZMod (vSeedPrime 2)) q2rzDinv q2rz_hDinv
    7 8 5 8 9
    q2rz_point0 q2rz_point1 q2rz_point2 q2rz_point3 q2rz_point4 q2rzW q2rz_hW q2rz_hrow

end
