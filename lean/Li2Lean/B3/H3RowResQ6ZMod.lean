theorem q6rz_LU4 : q6rzE * q6rzNbar4 = q6rzL4 * q6rzU4 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    first
      | decide +kernel
      | (norm_num [q6rzE, q6rzNbar4, q6rzL4, q6rzU4, Matrix.mul_apply, Fin.sum_univ_succ] <;>
          decide)

theorem q6rz_L4_det : q6rzL4.det = 1 := by
  rw [Matrix.det_of_isLowerTriangular q6rzL4 (by first | decide | decide +kernel)]
  first
    | decide
    | decide +kernel

theorem q6rz_U4_det : q6rzU4.det = 7 := by
  rw [Matrix.det_of_isUpperTriangular (M := q6rzU4) (by first | decide | decide +kernel)]
  first
    | decide
    | decide +kernel

theorem q6rz_point4 :
    seedEvalRes 6 4 * ((∏ r, q6rzD r : ℕ) : ZMod (vSeedPrime 6)) = 7 :=
  seed_point_residue q6SourceMatrixAtZeroExplicit q6rz_hsrc q6rzD q6rzN0 q6rzAN
    q6rz_hN0 q6rz_hAN q6rz_hD 4 q6rzE q6rzNbar4 q6rzL4 q6rzU4 q6rz_Nbar4 q6rz_E_det
    q6rz_LU4 q6rz_L4_det 7 q6rz_U4_det

/-! ## 4. Inverse Vandermonde modulo 17 and the residue row -/

def q6rzW : Matrix (Fin 5) (Fin 5) (ZMod (vSeedPrime 6)) := !![
  1, 0, 0, 0, 0;
  5, 4, 14, 7, 4;
  5, 7, 9, 9, 4;
  1, 10, 15, 4, 4;
  5, 14, 13, 14, 5]

-- VERIFIED: the entries `((t : ℕ) : ZMod p) ^ j` use `Fin.npow`, i.e. core
-- `Nat.powMod` (`@[semireducible]`, documented to reduce under `decide`);
-- master precedent `(2 : ZMod 11) ^ 2 * 3 = 1` by `decide` (`V/NegativeTwoSeed`).
-- FIXED: `norm_num` alternative evaluates the powers without `Nat.powMod`.
theorem q6rz_hW : q6rzW * seedVandermonde (vSeedPrime 6) = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    first
      | decide
      | decide +kernel
      | (norm_num [q6rzW, seedVandermonde, Matrix.mul_apply, Matrix.one_apply,
          Fin.sum_univ_succ] <;> decide)

-- VERIFIED: `vSeedResidueRow` is a literal match on `(q, ⟨k, _⟩)`
-- (`B3/ActualFrobeniusProducer.lean:57`); master decides it in
-- `vSeedResidueRow_lt_prime`.
theorem q6rz_hrow : Matrix.mulVec q6rzW ![15 * q6rzDinv, 11 * q6rzDinv, 2 * q6rzDinv, 2 * q6rzDinv, 7 * q6rzDinv] =
    fun i => (vSeedResidueRow 6 i : ZMod (vSeedPrime 6)) := by
  funext i
  fin_cases i <;> first | decide | decide +kernel
  -- values: W * e = [5, 12, 4, 7, 4], e = [5, 15, 12, 12, 8].

theorem q6_row_residue_zmod : ∀ i : Fin 5,
    vSeedCoeffResidue 6 i.val = (vSeedResidueRow 6 i : ZMod (vSeedPrime 6)) :=
  vSeedRowResidue_of_zmod (q := 6) (by first | norm_num [vSeedPrime] | decide)
    ((∏ r, q6rzD r : ℕ) : ZMod (vSeedPrime 6)) q6rzDinv q6rz_hDinv
    15 11 2 2 7
    q6rz_point0 q6rz_point1 q6rz_point2 q6rz_point3 q6rz_point4 q6rzW q6rz_hW q6rz_hrow

end
