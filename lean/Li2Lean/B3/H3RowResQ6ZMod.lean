theorem q6rz_hsrc : ∀ r c : Fin 9,
    (V.vSourceMatrix 1 (-((6 : ℕ) : ℤ)) r c).eval 0 = q6SourceMatrixAtZeroExplicit r c := by
  intro r c
  -- VERIFIED (master 7d5cd808): `q6SourceMatrixAtZero : Matrix (Fin 9) (Fin 9) ℚ :=
  -- fun r c => (V.vSourceMatrix 1 (-6 : ℤ) r c).eval 0` and
  -- `q6_source_eq_explicit : q6SourceMatrixAtZero = q6SourceMatrixAtZeroExplicit`.
  -- FIXED: definitional alternative (`-((6 : ℕ) : ℤ)` and `(-6 : ℤ)` are both
  -- `Int.negSucc 5` after whnf).
  first
    | (rw [show (-((6 : ℕ) : ℤ)) = (-6 : ℤ) by norm_num]
       exact congrFun (congrFun q6_source_eq_explicit r) c)
    | exact congrFun (congrFun q6_source_eq_explicit r) c

theorem q6rz_hN0 : ∀ r c : Fin 9,
    (q6rzD r : ℚ) * q6SourceMatrixAtZeroExplicit r c = (q6rzN0 r c : ℚ) := by
  intro r c
  fin_cases r <;> fin_cases c <;>
    norm_num [q6rzD, q6rzN0, q6SourceMatrixAtZeroExplicit]

theorem q6rz_hAN : ∀ r c : Fin 9,
    (q6rzD r : ℚ) * seedAEntry (-((6 : ℕ) : ℤ)) r c = (q6rzAN r c : ℚ) := by
  intro r c
  -- VERIFIED: same shape as `q6_source_eq_explicit` (a `Fin 9` literal read
  -- at `Fin (V.vMatrixSize 1)`; `Fin.val ⟨k, _⟩` reduces by projection).
  -- `V.vAEntry a i j := if i = j then (a : ℚ) ^ i else 0` (`V/VFamily.lean:90`).
  -- FIXED: the planned alternative runs automatically.
  fin_cases r <;> fin_cases c <;>
    first
      | (norm_num [q6rzD, q6rzAN, seedAEntry, V.vAEntry, V.vMatrixSize, V.vM, V.vS]; done)
      | (simp [q6rzD, q6rzAN, seedAEntry, V.vAEntry] <;> norm_num)

