theorem q6rz_Nbar4 : ∀ i j : Fin 9,
    ((q6rzN0 i j - ((4 : ℕ) : ℤ) * q6rzAN i j : ℤ) : ZMod (vSeedPrime 6)) = q6rzNbar4 i j := by
  intro i j
  fin_cases i <;> fin_cases j <;> first | decide | decide +kernel

-- FIXED: per-entry `decide +kernel` (one 9-term dot product in `Fin p` per
-- goal, no `norm_num` proof term); original `norm_num ... <;> decide` kept as
