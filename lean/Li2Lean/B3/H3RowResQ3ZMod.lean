theorem q3rz_hsrc : ∀ r c : Fin 9,
    (V.vSourceMatrix 1 (-((3 : ℕ) : ℤ)) r c).eval 0 = q3SourceMatrixAtZeroExplicit r c := by
  intro r c
  -- VERIFIED (master 7d5cd808): `q3SourceMatrixAtZero : Matrix (Fin 9) (Fin 9) ℚ :=
  -- fun r c => (V.vSourceMatrix 1 (-3 : ℤ) r c).eval 0` and
  -- `q3_source_eq_explicit : q3SourceMatrixAtZero = q3SourceMatrixAtZeroExplicit`.
  -- FIXED: definitional alternative (`-((3 : ℕ) : ℤ)` and `(-3 : ℤ)` are both
  -- `Int.negSucc 2` after whnf).
  first
    | (rw [show (-((3 : ℕ) : ℤ)) = (-3 : ℤ) by norm_num]
       exact congrFun (congrFun q3_source_eq_explicit r) c)
    | exact congrFun (congrFun q3_source_eq_explicit r) c

theorem q3rz_hN0 : ∀ r c : Fin 9,
    (q3rzD r : ℚ) * q3SourceMatrixAtZeroExplicit r c = (q3rzN0 r c : ℚ) := by
  intro r c
  fin_cases r <;> fin_cases c <;>
    norm_num [q3rzD, q3rzN0, q3SourceMatrixAtZeroExplicit]

theorem q3rz_hAN : ∀ r c : Fin 9,
    (q3rzD r : ℚ) * seedAEntry (-((3 : ℕ) : ℤ)) r c = (q3rzAN r c : ℚ) := by
  intro r c
  -- VERIFIED: same shape as `q3_source_eq_explicit` (a `Fin 9` literal read
  -- at `Fin (V.vMatrixSize 1)`; `Fin.val ⟨k, _⟩` reduces by projection).
  -- `V.vAEntry a i j := if i = j then (a : ℚ) ^ i else 0` (`V/VFamily.lean:90`).
  -- FIXED: the planned alternative runs automatically.
  fin_cases r <;> fin_cases c <;>
    first
      | (norm_num [q3rzD, q3rzAN, seedAEntry, V.vAEntry, V.vMatrixSize, V.vM, V.vS]; done)
      | (simp [q3rzD, q3rzAN, seedAEntry, V.vAEntry] <;> norm_num)

/-- `∏ r, q3rzD r ≡ 9 (mod 11)`, inverse `5`. -/
def q3rzDinv : ZMod (vSeedPrime 3) := 5

theorem q3rz_hDinv : ((∏ r, q3rzD r : ℕ) : ZMod (vSeedPrime 3)) * q3rzDinv = 1 := by
  -- VERIFIED: `decide` in `ZMod (vSeedPrime N)` with large literals is a master
  -- pattern (`Q2ActualSeedResidueProof.q2_inv_constant`, literal 2333772000000000).
  -- FIXED: alternatives run automatically.
  first
    | decide
    | decide +kernel
    | (simp only [Fin.prod_univ_succ, Fin.prod_univ_zero, q3rzD, q3rzDinv]
       decide)

-- VERIFIED: `left_ne_zero_of_mul_eq_one [MulZeroOneClass M₀] [Nontrivial M₀]
