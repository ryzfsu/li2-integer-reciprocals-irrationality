import Li2Lean.P0.CA.Receipt.Data
import Li2Lean.P0.CA.Contour.Rows.CsvCells

/-!
# Data identity: receipt contour rows = CA-C contour rows

`Receipt.Data.contourRows` (generated by CA-R from `contour_cells.csv`) and
`Contour.Rows.csvCells` (generated by CA-C from the same CSV, SHA-256
`88c04384…`) are the same list of rational cells. Checked by the kernel.
-/

set_option maxRecDepth 100000

namespace Li2Lean.P0.CA.Wire

theorem contourRows_eq :
    Receipt.Data.contourRows = Contour.Rows.csvCells.map Contour.Cell.cell := by
  decide +kernel

end Li2Lean.P0.CA.Wire
