theorem momTab_check :
    (List.range 49).all (fun n =>
      decide ((momTab.getD n (0, 0)).1 ≤ momentLoQ n) &&
        decide (momentHiQ n ≤ (momTab.getD n (0, 0)).2)) = true := by
  decide +kernel

theorem momTab_sound {n : ℕ} (hn : n < 49) :
    ((momTab.getD n (0, 0)).1 : ℝ) ≤ contourMoment n ∧
      contourMoment n ≤ ((momTab.getD n (0, 0)).2 : ℝ) := by
  have h := momTab_check
  rw [List.all_eq_true] at h
  have hn' := h n (List.mem_range.mpr hn)
  simp only [Bool.and_eq_true, decide_eq_true_eq] at hn'
  obtain ⟨h1, h2⟩ := moment_sound (n := n) (by omega)
  constructor
  · exact le_trans (by exact_mod_cast hn'.1) h1
  · exact le_trans h2 (by exact_mod_cast hn'.2)

def cScaleQ : ℚ := 24233 / 20000
def cRatioQ : ℚ := 1333 / 24233
def massQ : ℚ := 267885951940 / 1000000000000

theorem cScaleQ_cast : ((cScaleQ : ℚ) : ℝ) = contourScale := by
  unfold cScaleQ contourScale; push_cast; ring

theorem cRatioQ_cast : ((cRatioQ : ℚ) : ℝ) = contourRatio := by
  unfold cRatioQ contourRatio; push_cast; ring

/-- Lower bound for `(-1)^n (1 + q^n) m_n / n`. -/
def betaLo (n : ℕ) : ℚ :=
  if n % 2 = 0 then (1 + cRatioQ ^ n) / n * (momTab.getD n (0, 0)).1
  else -((1 + cRatioQ ^ n) / n * (momTab.getD n (0, 0)).2)

/-- Lower bound for the `n`th summand, given `sigma ∈ [slo, shi]`. -/
def termLoN (slo shi : ℚ) (n : ℕ) : ℚ :=
  if n = 0 then 0 else min (betaLo n * slo ^ n) (betaLo n * shi ^ n)

/-- The discriminant `(t + xi)^2 - 4 c^2 q` of the exterior Joukowski map. -/
def discQ (t : ℚ) : ℚ := (t + 11281 / 10000) ^ 2 - 4 * cScaleQ ^ 2 * cRatioQ

/-- Computable upper bound for `contourReferencePotential (-t)`. -/
def nuHiCore (rlo rhi : ℚ) : ℚ :=
  rup (massQ * (logBnd rhi).2 -
    sumTo (termLoN (rdn (cScaleQ / rhi)) (rup (cScaleQ / rlo))) 49)

def rloOf (t : ℚ) : ℚ := (t + 11281 / 10000 + sqrtLoAt roundScale (discQ t)) / 2
def rhiOf (t : ℚ) : ℚ := (t + 11281 / 10000 + sqrtHiAt roundScale (discQ t)) / 2
def sigLo (t : ℚ) : ℚ := rdn (cScaleQ / rhiOf t)
def sigHi (t : ℚ) : ℚ := rup (cScaleQ / rloOf t)

def nuHi (t : ℚ) : ℚ := nuHiCore (rloOf t) (rhiOf t)

theorem rdn_nonneg {q : ℚ} (hq : 0 ≤ q) : 0 ≤ rdn q := by
  unfold rdn rdnAt
  have : 0 ≤ ⌊q * roundScale⌋ := Int.floor_nonneg.mpr (mul_nonneg hq roundScale_pos.le)
  have h2 := roundScale_pos
  positivity

theorem beta_ge_betaLo {n : ℕ} (hn : n < 49) (hn0 : n ≠ 0) :
    (betaLo n : ℝ) ≤ (-1) ^ n * ((1 + contourRatio ^ n) * contourMoment n / (n : ℝ)) := by
  obtain ⟨h1, h2⟩ := momTab_sound hn
  have hf : (0 : ℝ) < (1 + contourRatio ^ n) / n := by
    have : (0 : ℝ) < n := by exact_mod_cast Nat.pos_of_ne_zero hn0
    have : 0 ≤ contourRatio ^ n := pow_nonneg contourRatio_nonneg n
    positivity
  unfold betaLo
  split_ifs with hpar
  · have he : Even n := Nat.even_iff.mpr hpar
    rw [he.neg_one_pow, one_mul]
    push_cast
    rw [cRatioQ_cast, mul_div_right_comm]
    exact mul_le_mul_of_nonneg_left h1 hf.le
  · have ho : Odd n := Nat.odd_iff.mpr (by omega)
    rw [ho.neg_one_pow]
    push_cast
    rw [cRatioQ_cast, mul_div_right_comm]
    have := mul_le_mul_of_nonneg_left h2 hf.le
    linarith

theorem min_mul_le {b blo p plo phi : ℝ} (hb : blo ≤ b) (hp0 : 0 ≤ plo)
    (hp1 : plo ≤ p) (hp2 : p ≤ phi) : min (blo * plo) (blo * phi) ≤ b * p := by
  have hp : 0 ≤ p := le_trans hp0 hp1
  have h1 : blo * p ≤ b * p := mul_le_mul_of_nonneg_right hb hp
  rcases le_total 0 blo with hb0 | hb0
  · exact le_trans (min_le_left _ _) (le_trans (mul_le_mul_of_nonneg_left hp1 hb0) h1)
  · exact le_trans (min_le_right _ _) (le_trans (mul_le_mul_of_nonpos_left hp2 hb0) h1)

/-- The rational upper bound is sound for every rational `t ≥ 1/2`. -/
theorem nu_core {t : ℚ} (ht : (1 / 2 : ℚ) ≤ t) :
    0 < rhiOf t ∧ 0 ≤ sigLo t ∧ sigLo t ≤ sigHi t ∧
    contourReferencePotential (-((t : ℝ) : ℂ)) ≤
      (267885951940 / 1000000000000 : ℝ) * Real.log (rhiOf t : ℝ) -
        ((sumTo (termLoN (sigLo t) (sigHi t)) 49 : ℚ) : ℝ) := by
  have htR : (1 / 2 : ℝ) ≤ (t : ℝ) := half_le_cast ht
  rw [contourReferencePotential_neg (t : ℝ) htR]
  have hdisc := outside_discriminant_nonneg htR
  have hD : ((discQ t : ℚ) : ℝ) =
      ((t : ℝ) + 11281 / 10000) ^ 2 - 4 * contourScale ^ 2 * contourRatio := by
    unfold discQ
    push_cast
    rw [cScaleQ_cast, cRatioQ_cast]
  have hDq : 0 ≤ discQ t := by
    have : (0 : ℝ) ≤ ((discQ t : ℚ) : ℝ) := by rw [hD]; exact hdisc
    exact_mod_cast this
  have hsl := sqrtLoAt_le roundScale_pos hDq
  have hsh := le_sqrtHiAt roundScale_pos hDq
  rw [hD] at hsl hsh
  set rlo : ℚ := rloOf t with hrlo
  set rhi : ℚ := rhiOf t with hrhi
  have hR1 : (rlo : ℝ) ≤ outsideRadius t := by
    rw [hrlo, rloOf]; unfold outsideRadius; push_cast; linarith
  have hR2 : outsideRadius t ≤ (rhi : ℝ) := by
    rw [hrhi, rhiOf]; unfold outsideRadius; push_cast; linarith
  have hRpos := outsideRadius_pos htR
  have hrlo_pos : (0 : ℝ) < rlo := by
    rw [hrlo, rloOf]; push_cast
    have := sqrtLoAt_nonneg roundScale_pos (discQ t)
    have : (0 : ℝ) ≤ sqrtLoAt roundScale (discQ t) := by exact_mod_cast this
    linarith
  have hrhi_pos : (0 : ℚ) < rhi := by exact_mod_cast lt_of_lt_of_le hRpos hR2
  have hlog : Real.log (outsideRadius t) ≤ Real.log (rhi : ℝ) := Real.log_le_log hRpos hR2
  -- sigma bounds
  set sig : ℝ := contourScale / outsideRadius t with hsig
  have hcs := contourScale_pos
  have hsig_pos : 0 < sig := div_pos hcs hRpos
  have hs1 : ((rdn (cScaleQ / rhi) : ℚ) : ℝ) ≤ sig := by
    apply rdn_le_real
    push_cast
    rw [cScaleQ_cast]
    exact div_le_div_of_nonneg_left hcs.le hRpos hR2
  have hs2 : sig ≤ ((rup (cScaleQ / rlo) : ℚ) : ℝ) := by
    apply le_rup_real
    push_cast
    rw [cScaleQ_cast]
    exact div_le_div_of_nonneg_left hcs.le hrlo_pos hR1
  have hs0 : (0 : ℝ) ≤ ((rdn (cScaleQ / rhi) : ℚ) : ℝ) := by
    have : 0 ≤ cScaleQ / rhi := div_nonneg (by norm_num [cScaleQ]) hrhi_pos.le
    exact_mod_cast rdn_nonneg this
  -- the polynomial part
  have hpoly : ((sumTo (termLoN (rdn (cScaleQ / rhi)) (rup (cScaleQ / rlo))) 49 : ℚ) : ℝ) ≤
      ∑ n ∈ Finset.range 49,
        ((1 + contourRatio ^ n) * contourMoment n / (n : ℝ)) * outsideParameter t ^ n := by
    rw [sumTo_eq]
    push_cast
    apply Finset.sum_le_sum
    intro n hn
    have hn49 := Finset.mem_range.mp hn
    unfold termLoN
    split_ifs with hn0
    · subst hn0; simp
    · have hpar : outsideParameter t ^ n = (-1) ^ n * sig ^ n := by
        rw [← mul_pow]; unfold outsideParameter; rw [hsig]; ring
      rw [hpar]
      have hb := beta_ge_betaLo hn49 hn0
      have hp1 : ((rdn (cScaleQ / rhi) : ℚ) : ℝ) ^ n ≤ sig ^ n :=
        pow_le_pow_left₀ hs0 hs1 n
      have hp2 : sig ^ n ≤ ((rup (cScaleQ / rlo) : ℚ) : ℝ) ^ n :=
        pow_le_pow_left₀ hsig_pos.le hs2 n
      have := min_mul_le hb (pow_nonneg hs0 n) hp1 hp2
      push_cast at this ⊢
      calc _ ≤ _ := this
        _ = _ := by ring
  refine ⟨hrhi_pos, ?_, ?_, ?_⟩
  · exact_mod_cast hs0
  · have : ((sigLo t : ℚ) : ℝ) ≤ ((sigHi t : ℚ) : ℝ) := le_trans hs1 hs2
    exact_mod_cast this
  · have : (267885951940 / 1000000000000 : ℝ) * Real.log (outsideRadius t) ≤
        (267885951940 / 1000000000000 : ℝ) * Real.log (rhi : ℝ) :=
      mul_le_mul_of_nonneg_left hlog (by norm_num)
    unfold sigLo sigHi
    rw [← hrlo, ← hrhi]
    linarith

/-- The rational upper bound is sound for every rational `t ≥ 1/2`. -/
theorem contourReferencePotential_neg_le_nuHi {t : ℚ} (ht : (1 / 2 : ℚ) ≤ t) :
    contourReferencePotential (-((t : ℝ) : ℂ)) ≤ (nuHi t : ℝ) := by
  obtain ⟨hpos, _, _, h⟩ := nu_core ht
  have hl := (logBnd_sound hpos).2
  unfold nuHi nuHiCore
  apply le_rup_real
  have hmass : ((massQ : ℚ) : ℝ) = 267885951940 / 1000000000000 := by
    unfold massQ; push_cast; ring
  unfold sigLo sigHi at h
  rw [Rat.cast_sub, Rat.cast_mul, hmass]
  have := mul_le_mul_of_nonneg_left hl (by norm_num : (0 : ℝ) ≤ 267885951940 / 1000000000000)
  linarith

/-- The derivative of the contour potential on the negative axis is nonnegative. -/
theorem contourTailDerivative_nonneg {t : ℝ} (ht : leftClearance < t) :
    0 ≤ contourTailDerivative t := by
  unfold contourTailDerivative
  apply mul_nonneg (inv_nonneg.mpr (by positivity))
  apply intervalIntegral.integral_nonneg (by positivity)
  intro u _
  exact mul_nonneg (contourDensity_nonneg u) (tailKernelDeriv_nonneg ht u)

/-- `t ↦ contourReferencePotential (-t)` is monotone on `[1/2, ∞)`. -/
theorem contourNeg_monotoneOn :
    MonotoneOn (fun s : ℝ => contourReferencePotential (-(s : ℂ))) (Set.Ici (1 / 2)) := by
  have hclear (x : ℝ) (hx : 1 / 2 ≤ x) : leftClearance < x := by
    unfold leftClearance; linarith
  apply monotoneOn_of_deriv_nonneg (convex_Ici _)
  · intro x hx
    exact (hasDerivAt_contourReferencePotential_neg (hclear x hx)).continuousAt.continuousWithinAt
  · intro x hx
    rw [interior_Ici] at hx
    exact (hasDerivAt_contourReferencePotential_neg
      (hclear x (le_of_lt hx))).differentiableAt.differentiableWithinAt
  · intro x hx
    rw [interior_Ici] at hx
    rw [(hasDerivAt_contourReferencePotential_neg (hclear x (le_of_lt hx))).deriv]
    exact contourTailDerivative_nonneg (hclear x (le_of_lt hx))

