/-- Boolean exact-chain check (same recursion as `ExactChainSpec`). -/
def chainOK : List ReceiptCell → ℚ → ℚ → Bool
  | [], _, _ => false
  | [c], a, b => decide (c.lo = a) && decide (c.hi = b) && decide (c.lo ≤ c.hi)
  | c :: d :: rest, a, b =>
      decide (c.lo = a) && decide (c.hi = d.lo) && decide (c.lo ≤ c.hi) &&
        chainOK (d :: rest) d.lo b

theorem chainOK_spec : ∀ (l : List ReceiptCell) (a b : ℚ),
    chainOK l a b = true → ExactChainSpec l a b
  | [], _, _, h => by simp [chainOK] at h
  | [c], a, b, h => by
      simp only [chainOK, Bool.and_eq_true, decide_eq_true_eq] at h
      exact ⟨h.1.1, h.1.2, h.2⟩
  | c :: d :: rest, a, b, h => by
      simp only [chainOK, Bool.and_eq_true, decide_eq_true_eq] at h
      exact ⟨h.1.1.1, h.1.1.2, h.1.2, chainOK_spec (d :: rest) d.lo b h.2⟩

theorem frequencyRows_chainOK : chainOK frequencyRows (1 / 2) (81 / 10) = true := by
  decide +kernel

theorem frequencyRows_exactChain : ExactChain frequencyRows (1 / 2) (81 / 10) :=
  exactChain_iff_spec.mpr (chainOK_spec _ _ _ frequencyRows_chainOK)

/-- Floor margin needed by the slack receipt, `-1673/500 + 1/10000`. -/
theorem frequencyRows_floor :
    frequencyRows.all (fun c => decide (Li2Lean.P0.caSlackFloor + 1 / 10000 ≤ c.lower)) = true := by
  decide +kernel

/-- The rows with their uniform `1/10000` allowance, as `SlackRow`s. -/
def frequencySlackRows : List Li2Lean.P0.SlackRow :=
  frequencyRows.map fun c => ⟨c, 1 / 10000, by norm_num⟩

theorem frequencySlackRows_cells :
    Li2Lean.P0.slackCells frequencySlackRows = frequencyRows := by
  unfold Li2Lean.P0.slackCells frequencySlackRows
  rw [List.map_map]
  conv_rhs => rw [← List.map_id frequencyRows]
  rfl

theorem frequencySlackRows_length : frequencySlackRows.length = 16384 := by
  simp [frequencySlackRows, frequencyRows_length]

theorem frequencySlackRows_exactChain :
    ExactChain (Li2Lean.P0.slackCells frequencySlackRows) (1 / 2) (81 / 10) := by
  rw [frequencySlackRows_cells]; exact frequencyRows_exactChain

theorem frequencySlackRows_allowance :
    ∀ r ∈ frequencySlackRows, r.allowance = 1 / 10000 := by
  intro r hr
  obtain ⟨c, _, rfl⟩ := List.mem_map.mp hr
  rfl

/-- ORIGINAL row floors (allowance unused) for every slack frequency row. -/
theorem frequencySlackRows_original_valid :
    ∀ r ∈ frequencySlackRows, ∀ hw : r.cell.lo ≤ r.cell.hi,
      r.cell.modelRemainderValid (Config.Wmu actualReference) hw := by
  intro r hr hw
  obtain ⟨c, hc, rfl⟩ := List.mem_map.mp hr
  exact frequencyRows_modelRemainderValid c hc hw

theorem modelRemainderValid_afterAllowance_of_original {c : ReceiptCell} {a : ℚ}
    (ha : 0 ≤ a) {f : ℝ → ℝ} (hw : c.lo ≤ c.hi) (h : c.modelRemainderValid f hw) :
    (c.afterAllowance a).modelRemainderValid f hw := by
  unfold ReceiptCell.modelRemainderValid ContourKit.TaylorLowerRemainderValid at *
  intro x hx
  have h1 := h x hx
  have haR : (0 : ℝ) ≤ a := by exact_mod_cast ha
  simp only [ReceiptCell.model, ReceiptCell.afterAllowance, ContourKit.horner] at h1 ⊢
  push_cast at h1 ⊢
  linarith

/-- Consequently the spent (floor minus allowance) rows are valid as well. -/
theorem frequencySlackRows_spent_valid :
    ∀ r ∈ frequencySlackRows, ∀ hw : r.cell.lo ≤ r.cell.hi,
      (r.cell.afterAllowance r.allowance).modelRemainderValid
        (Config.Wmu actualReference) hw := by
  intro r hr hw
  exact modelRemainderValid_afterAllowance_of_original r.allowance_nonneg hw
    (frequencySlackRows_original_valid r hr hw)

