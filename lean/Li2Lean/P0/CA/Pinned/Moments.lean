import Li2Lean.P0.CA.Pinned.LogEval
import Li2Lean.P0.ConfigFejerLog

/-!
# Certified enclosures of the 49 Fejer contour moments

`cos (π r / 64)` is enclosed for `r < 128` by the complex exponential Taylor
remainder (`Complex.exp_bound'`) evaluated on a rational interval containing
`π r / 64` (Mathlib's 20-digit bounds for `π`).  The literal tables below are
checked against these computed enclosures by `decide +kernel`; the moment
table is then checked against the exact weighted sums of `contourMoment`.
-/

namespace Li2Lean.P0.CA.Pinned

open Li2Lean.P0.ConfigContourReference
open Li2Lean.P0.ConfigFejerLog

/-! ## Cosine Taylor polynomial -/

def cosCoef (m : ℕ) : ℚ :=
  if m % 2 = 1 then 0 else (if m % 4 = 0 then 1 else -1) / (m.factorial : ℚ)

def cosCoeffs (N : ℕ) : List ℚ := (List.range N).map cosCoef

theorem I_pow_re (m : ℕ) :
    (Complex.I ^ m).re = if m % 2 = 1 then 0 else (if m % 4 = 0 then 1 else -1) := by
  have hm : m = 4 * (m / 4) + m % 4 := (Nat.div_add_mod m 4).symm
  have hr : m % 4 < 4 := Nat.mod_lt _ (by norm_num)
  have h2 : m % 2 = (m % 4) % 2 := by omega
  rw [hm, pow_add, pow_mul, Complex.I_pow_four, one_pow, one_mul, ← hm, h2]
  interval_cases h : m % 4 <;> simp [h, pow_succ]

theorem cos_taylor (x : ℝ) (N : ℕ) (hx : |x| / (N.succ : ℝ) ≤ 1 / 2) :
    |Real.cos x - hornerR (castL (cosCoeffs N)) x| ≤ |x| ^ N / N.factorial * 2 := by
  have hb := Complex.exp_bound' (x := (x : ℂ) * Complex.I) (n := N) (by
    simpa [Complex.norm_mul, Complex.norm_real, Real.norm_eq_abs] using hx)
  have hnorm : ‖(x : ℂ) * Complex.I‖ = |x| := by
    simp [Complex.norm_mul, Complex.norm_real, Real.norm_eq_abs]
  rw [hnorm] at hb
  refine le_trans ?_ hb
  have hre : (Complex.exp ((x : ℂ) * Complex.I) -
      ∑ m ∈ Finset.range N, ((x : ℂ) * Complex.I) ^ m / (m.factorial : ℂ)).re =
      Real.cos x - hornerR (castL (cosCoeffs N)) x := by
    rw [Complex.sub_re, Complex.exp_ofReal_mul_I_re, Complex.re_sum, cosCoeffs,
      hornerR_range]
    congr 1
    apply Finset.sum_congr rfl
    intro m _
    rw [mul_pow, ← Complex.ofReal_pow, ← Complex.ofReal_natCast, mul_div_assoc,
      Complex.re_ofReal_mul]
    rw [show (Complex.I ^ m / ((m.factorial : ℝ) : ℂ)) =
        (((m.factorial : ℝ))⁻¹ : ℝ) * Complex.I ^ m by push_cast; ring,
      Complex.re_ofReal_mul, I_pow_re]
    unfold cosCoef
    split_ifs <;> push_cast <;> ring
  rw [← hre]
  exact Complex.abs_re_le_norm _

/-! ## Rational enclosure of `cos (π r / 64)` -/

def piLo : ℚ := 314159265358979323846 / 100000000000000000000
def piHi : ℚ := 314159265358979323847 / 100000000000000000000

theorem pi_mem : (QI.mk piLo piHi).Contains Real.pi := by
  constructor
  · have := Real.pi_gt_d20; simp only [piLo]; push_cast; norm_num at this ⊢; linarith
  · have := Real.pi_lt_d20; simp only [piHi]; push_cast; norm_num at this ⊢; linarith

def cosArg (r : ℕ) : QI := ⟨(r : ℚ) * piLo / 64, (r : ℚ) * piHi / 64⟩

/-- Horner evaluation with outward rounding after every step. -/
def hornerIR : List ℚ → QI → QI
  | [], _ => QI.pt 0
  | a :: as, T => QI.round (QI.add (QI.pt a) (QI.mul T (hornerIR as T)))

theorem hornerIR_sound (p : List ℚ) {T : QI} {t : ℝ} (ht : T.Contains t) :
    (hornerIR p T).Contains (hornerR (castL p) t) := by
  induction p with
  | nil => simpa [hornerIR, hornerR, castL] using QI.mem_pt (0 : ℚ)
  | cons a as ih =>
      simpa [hornerIR, hornerR, castL] using
        QI.mem_round (QI.mem_add (QI.mem_pt a) (QI.mem_mul ht ih))

/-- Enclosure on the first quadrant, `r ≤ 32`. -/
def cosBase (r : ℕ) : QI :=
  QI.widen (hornerIR (cosCoeffs 30) (cosArg r))
    ((cosArg r).hi ^ 30 / ((Nat.factorial 30 : ℕ) : ℚ) * 2)

theorem cosBase_sound (r : ℕ) (hr : r ≤ 32) :
    (cosBase r).Contains (Real.cos (Real.pi * r / 64)) := by
  have hx : (cosArg r).Contains (Real.pi * r / 64) := by
    have h := pi_mem
    simp only [QI.Contains, cosArg] at h ⊢
    push_cast
    have hr0 : (0 : ℝ) ≤ r := by positivity
    constructor <;> nlinarith [h.1, h.2]
  have hpos : 0 ≤ Real.pi * r / 64 := by positivity
  have hrR : (r : ℝ) ≤ 32 := by exact_mod_cast hr
  have hhiv : ((cosArg r).hi : ℝ) ≤ 2 := by
    simp only [cosArg, piHi]; push_cast; nlinarith
  have hcond : |Real.pi * r / 64| / ((30 : ℕ).succ : ℝ) ≤ 1 / 2 := by
    rw [abs_of_nonneg hpos]; push_cast; linarith [hx.2]
  have ht := cos_taylor (Real.pi * r / 64) 30 hcond
  have herr : |Real.pi * r / 64| ^ 30 / (Nat.factorial 30 : ℝ) * 2 ≤
      ((((cosArg r).hi ^ 30 / ((Nat.factorial 30 : ℕ) : ℚ) * 2 : ℚ)) : ℝ) := by
    rw [abs_of_nonneg hpos]; push_cast
    gcongr
    exact hx.2
  exact QI.mem_widen (hornerIR_sound (cosCoeffs 30) hx) (ht.trans herr)

def cosEnc (r : ℕ) : QI :=
  if r ≤ 32 then cosBase r
  else if r ≤ 64 then QI.neg (cosBase (64 - r))
  else if r ≤ 96 then QI.neg (cosBase (r - 64))
  else cosBase (128 - r)

theorem cosEnc_sound (r : ℕ) (hr : r < 128) :
    (cosEnc r).Contains (Real.cos (Real.pi * r / 64)) := by
  unfold cosEnc
  split_ifs with h1 h2 h3
  · exact cosBase_sound r h1
  · have h := QI.mem_neg (cosBase_sound (64 - r) (by omega))
    have e : Real.pi * ((64 - r : ℕ) : ℝ) / 64 = Real.pi - Real.pi * r / 64 := by
      rw [Nat.cast_sub (by omega)]; push_cast; ring
    rw [e, Real.cos_pi_sub, neg_neg] at h
    exact h
  · have h := QI.mem_neg (cosBase_sound (r - 64) (by omega))
    have e : Real.pi * r / 64 = Real.pi * ((r - 64 : ℕ) : ℝ) / 64 + Real.pi := by
      rw [Nat.cast_sub (by omega)]; push_cast; ring
    rw [e, Real.cos_add_pi]
    exact h
  · have h := cosBase_sound (128 - r) (by omega)
    have e : Real.pi * ((128 - r : ℕ) : ℝ) / 64 = 2 * Real.pi - Real.pi * r / 64 := by
      rw [Nat.cast_sub (by omega)]; push_cast; ring
    rw [e, Real.cos_two_pi_sub] at h
    exact h

