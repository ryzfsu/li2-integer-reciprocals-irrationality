def tableOK (T : List QI) (f : ℕ → QI) (n : ℕ) : Bool :=
  (List.range n).all (fun r => QI.subset (f r) (T.getD r ⟨0, 0⟩))

theorem tableOK_mem {T : List QI} {f : ℕ → QI} {n : ℕ} (h : tableOK T f n = true)
    {r : ℕ} (hr : r < n) {x : ℝ} (hx : (f r).Contains x) : (T.getD r ⟨0, 0⟩).Contains x := by
  unfold tableOK at h
  rw [List.all_eq_true] at h
  exact QI.mem_of_subset (h r (List.mem_range.mpr hr)) hx

theorem cosTable_ok : tableOK cosTable cosEnc 128 = true := by decide +kernel

theorem cosTable_mem (r : ℕ) (hr : r < 128) :
    (cosTable.getD r ⟨0, 0⟩).Contains (Real.cos (Real.pi * r / 64)) :=
  tableOK_mem cosTable_ok hr (cosEnc_sound r hr)

/-! ## Moments -/

def weightQ (j : ℕ) : ℚ :=
  (Li2Lean.P0.ConfigData.contourMassUnits.getD j 0 : ℚ) / 1000000000000

def sumI : List QI → QI
  | [] => QI.pt 0
  | I :: Is => QI.add I (sumI Is)

theorem sumI_sound : ∀ {Is : List QI} {xs : List ℝ}, List.Forall₂ QI.Contains Is xs →
    (sumI Is).Contains xs.sum
  | [], [], List.Forall₂.nil => by simpa [sumI] using QI.mem_pt (0 : ℚ)
  | _ :: _, _ :: _, List.Forall₂.cons h hs => by
      simpa [sumI] using QI.mem_add h (sumI_sound hs)

theorem finset_sum_range_eq_list (n : ℕ) (a : ℕ → ℝ) :
    ∑ j ∈ Finset.range n, a j = ((List.range n).map a).sum := by
  induction n with
  | zero => simp
  | succ n ih => rw [Finset.sum_range_succ, ih, List.range_succ, List.map_append,
      List.sum_append]; simp

theorem sumI_range (n : ℕ) (I : ℕ → QI) (a : ℕ → ℝ) (h : ∀ j < n, (I j).Contains (a j)) :
    (sumI ((List.range n).map I)).Contains (∑ j ∈ Finset.range n, a j) := by
  rw [finset_sum_range_eq_list]
  apply sumI_sound
  rw [List.forall₂_map_left_iff, List.forall₂_map_right_iff, List.forall₂_same]
  intro j hj
  exact h j (List.mem_range.mp hj)

def momentComp (n : ℕ) : QI :=
  QI.smul (1 - (n : ℚ) / 49)
    (sumI ((List.range 64).map (fun j =>
      QI.smul (weightQ j) (cosTable.getD ((n * (2 * j + 1)) % 128) ⟨0, 0⟩))))

theorem momentTable_ok : tableOK momentTable momentComp 49 = true := by decide +kernel

theorem cos_contourAngle (n j : ℕ) :
    Real.cos ((n : ℝ) * (Real.pi * (2 * (j : ℝ) + 1) / 64)) =
      Real.cos (Real.pi * (((n * (2 * j + 1)) % 128 : ℕ) : ℝ) / 64) := by
  have hdm := Nat.div_add_mod (n * (2 * j + 1)) 128
  have : (n : ℝ) * (Real.pi * (2 * (j : ℝ) + 1) / 64) =
      Real.pi * (((n * (2 * j + 1)) % 128 : ℕ) : ℝ) / 64 +
        (((n * (2 * j + 1)) / 128 : ℕ) : ℝ) * (2 * Real.pi) := by
    have hc : ((n * (2 * j + 1) : ℕ) : ℝ) =
        128 * (((n * (2 * j + 1)) / 128 : ℕ) : ℝ) + (((n * (2 * j + 1)) % 128 : ℕ) : ℝ) := by
      exact_mod_cast hdm.symm
    push_cast at hc
    linear_combination (Real.pi / 64) * hc
  rw [this, Real.cos_add_nat_mul_two_pi]

theorem momentComp_sound (n : ℕ) : (momentComp n).Contains (contourMoment n) := by
  unfold momentComp contourMoment
  have hsum : (sumI ((List.range 64).map (fun j =>
      QI.smul (weightQ j) (cosTable.getD ((n * (2 * j + 1)) % 128) ⟨0, 0⟩)))).Contains
      (∑ j ∈ Finset.range 64, (weightQ j : ℝ) *
        Real.cos (Real.pi * (((n * (2 * j + 1)) % 128 : ℕ) : ℝ) / 64)) := by
    apply sumI_range
    intro j _
    exact QI.mem_smul _ (cosTable_mem _ (Nat.mod_lt _ (by norm_num)))
  have h := QI.mem_smul (1 - (n : ℚ) / 49) hsum
  convert h using 1
  push_cast
  congr 1
  rw [← Fin.sum_univ_eq_sum_range]
  apply Finset.sum_congr rfl
  intro j _
  rw [show contourAngle j = Real.pi * (2 * ((j : ℕ) : ℝ) + 1) / 64 from rfl, cos_contourAngle]
  congr 1
  simp [contourWeight, weightQ, Li2Lean.P0.ConfigData.referenceDenominator]

theorem moment_mem (n : ℕ) (hn : n < 49) :
    (momentTable.getD n ⟨0, 0⟩).Contains (contourMoment n) :=
  tableOK_mem momentTable_ok hn (momentComp_sound n)

