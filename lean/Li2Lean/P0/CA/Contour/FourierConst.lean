def QI.sub_le (I J : QI) : Bool := decide (J.lo ≤ I.lo ∧ I.hi ≤ J.hi)

theorem QI.mem_of_sub_le {I J : QI} {x : ℝ} (h : QI.sub_le I J = true) (hx : I.mem x) :
    J.mem x := by
  have h' := of_decide_eq_true h
  have a : (J.lo : ℝ) ≤ I.lo := by exact_mod_cast h'.1
  have b : (I.hi : ℝ) ≤ J.hi := by exact_mod_cast h'.2
  exact ⟨a.trans hx.1, hx.2.trans b⟩

/-! ## Half-angle chain -/

def halfStepOK (I J : QI) : Bool :=
  decide (0 ≤ J.lo ∧ J.lo ^ 2 ≤ (1 + I.lo) / 2 ∧ (1 + I.hi) / 2 ≤ J.hi ^ 2 ∧ 0 ≤ J.hi)

theorem halfChain_ok : ∀ k < 5, halfStepOK (halfChain.getD k ⟨0, 0⟩)
    (halfChain.getD (k + 1) ⟨0, 0⟩) = true := by decide +kernel

theorem sqrt_mem {I J : QI} {v : ℝ} (h : halfStepOK I J = true) (hv : I.mem v) :
    J.mem (Real.sqrt ((1 + v) / 2)) := by
  have h' := of_decide_eq_true h
  have l0 : (0 : ℝ) ≤ J.lo := by exact_mod_cast h'.1
  have l2 : (J.lo : ℝ) ^ 2 ≤ (1 + I.lo) / 2 := by exact_mod_cast h'.2.1
  have h2 : (1 + (I.hi : ℝ)) / 2 ≤ (J.hi : ℝ) ^ 2 := by exact_mod_cast h'.2.2.1
  have h0 : (0 : ℝ) ≤ J.hi := by exact_mod_cast h'.2.2.2
  constructor
  · rw [← Real.sqrt_sq l0]
    exact Real.sqrt_le_sqrt (by linarith [hv.1])
  · rw [← Real.sqrt_sq h0]
    exact Real.sqrt_le_sqrt (by linarith [hv.2])

theorem halfChain_mem : ∀ k < 6, (halfChain.getD k ⟨0, 0⟩).mem
    (Real.cos (Real.pi / 2 ^ (k + 1))) := by
  intro k hk
  induction k with
  | zero =>
      have h0 : decide ((halfChain.getD 0 ⟨0, 0⟩).lo = 0 ∧ (halfChain.getD 0 ⟨0, 0⟩).hi = 0)
          = true := by decide +kernel
      have h0' := of_decide_eq_true h0
      simp only [QI.mem, h0'.1, h0'.2, zero_add, pow_one, Real.cos_pi_div_two, Rat.cast_zero,
        le_refl, and_self]
  | succ k ih =>
      have hprev := ih (by omega)
      have hstep := sqrt_mem (halfChain_ok k (by omega)) hprev
      have hx : Real.pi / 2 ^ (k + 1 + 1) = (Real.pi / 2 ^ (k + 1)) / 2 := by
        rw [pow_succ]; ring
      rw [hx, Real.cos_half]
      · exact hstep
      · have : 0 ≤ Real.pi / 2 ^ (k + 1) := by positivity
        linarith [Real.pi_pos]
      · have h1 : (1 : ℝ) ≤ 2 ^ (k + 1) := one_le_pow₀ (by norm_num)
        exact div_le_self Real.pi_pos.le h1

/-! ## Cosine table -/

theorem cosTab_one : QI.sub_le (halfChain.getD 5 ⟨0, 0⟩) (cosTab.getD 1 ⟨0, 0⟩) = true := by
  decide +kernel
theorem cosTab_zero : QI.sub_le (pt 1) (cosTab.getD 0 ⟨0, 0⟩) = true := by decide +kernel

def chebOK (m : ℕ) : Bool :=
  QI.sub_le (sub (smul 2 (mul (cosTab.getD 1 ⟨0, 0⟩) (cosTab.getD (m + 1) ⟨0, 0⟩)))
    (cosTab.getD m ⟨0, 0⟩)) (cosTab.getD (m + 2) ⟨0, 0⟩)

theorem chebOK_all : ∀ m < 126, chebOK m = true := by decide +kernel

theorem cos_rec (m : ℕ) (x : ℝ) :
    Real.cos ((m + 2 : ℕ) * x) = 2 * (Real.cos x * Real.cos ((m + 1 : ℕ) * x)) -
      Real.cos (m * x) := by
  have h1 : ((m + 2 : ℕ) : ℝ) * x = ((m + 1 : ℕ) : ℝ) * x + x := by push_cast; ring
  have h2 : (m : ℝ) * x = ((m + 1 : ℕ) : ℝ) * x - x := by push_cast; ring
  rw [h1, h2, Real.cos_add, Real.cos_sub]
  ring

theorem cosTab_mem : ∀ m < 128, (cosTab.getD m ⟨0, 0⟩).mem (Real.cos (m * (Real.pi / 64))) := by
  have h1 : (cosTab.getD 1 ⟨0, 0⟩).mem (Real.cos (Real.pi / 64)) := by
    apply QI.mem_of_sub_le cosTab_one
    have := halfChain_mem 5 (by norm_num)
    norm_num at this ⊢
    exact this
  have key : ∀ m, m < 127 → (cosTab.getD m ⟨0, 0⟩).mem (Real.cos (m * (Real.pi / 64))) ∧
      (cosTab.getD (m + 1) ⟨0, 0⟩).mem (Real.cos ((m + 1 : ℕ) * (Real.pi / 64))) := by
    intro m
    induction m with
    | zero =>
        intro _
        refine ⟨?_, ?_⟩
        · exact QI.mem_of_sub_le cosTab_zero (by simpa using mem_pt 1)
        · simpa using h1
    | succ m ih =>
        intro hm
        obtain ⟨a, b⟩ := ih (by omega)
        refine ⟨b, ?_⟩
        have hc := mem_sub (mem_smul 2 (mem_mul h1 b)) a
        have := QI.mem_of_sub_le (chebOK_all m (by omega)) hc
        rw [cos_rec m (Real.pi / 64)]
        push_cast at this ⊢
        exact this
  intro m hm
  rcases Nat.lt_succ_iff_lt_or_eq.mp hm with h | h
  · exact (key m h).1
  · subst h; have := (key 126 (by norm_num)).2; simpa using this

theorem cos_mod (m : ℕ) :
    Real.cos (m * (Real.pi / 64)) = Real.cos ((m % 128 : ℕ) * (Real.pi / 64)) := by
  have hm : (m : ℝ) = ((m % 128 : ℕ) : ℝ) + ((m / 128 : ℕ) : ℝ) * 128 := by
    have := Nat.mod_add_div m 128
    exact_mod_cast (by omega : m = m % 128 + m / 128 * 128)
  rw [hm, show (((m % 128 : ℕ) : ℝ) + ((m / 128 : ℕ) : ℝ) * 128) * (Real.pi / 64) =
      ((m % 128 : ℕ) : ℝ) * (Real.pi / 64) + ((m / 128 : ℕ) : ℝ) * (2 * Real.pi) by ring,
    Real.cos_add_nat_mul_two_pi]

theorem cosTab_mem_any (m : ℕ) :
    (cosTab.getD (m % 128) ⟨0, 0⟩).mem (Real.cos (m * (Real.pi / 64))) := by
  rw [cos_mod]; exact cosTab_mem _ (Nat.mod_lt _ (by norm_num))

/-! ## Moments and coefficients -/

def wq (j : ℕ) : ℚ := (ConfigData.contourMassUnits.getD j 0 : ℚ) / 1000000000000

def momI (k : ℕ) : QI :=
  smul (1 - (k : ℚ) / 49)
    (sumIdx 64 (fun j => smul (wq j) (cosTab.getD ((k * (2 * j + 1)) % 128) ⟨0, 0⟩)))

theorem momI_mem {k : ℕ} (hk : k ≤ 48) : (momI k).mem (contourFourierMoment k) := by
  unfold momI contourFourierMoment
  have hK : K48Coeff k = (((1 - (k : ℚ) / 49 : ℚ)) : ℝ) := by
    rw [K48Coeff, if_pos hk]; push_cast; ring
  rw [hK]
  apply mem_smul
  set g : ℕ → ℝ := fun j => (ConfigData.contourMassUnits.getD j 0 : ℝ) /
    (ConfigData.referenceDenominator : ℝ) * Real.cos (k * (Real.pi * (2 * (j : ℝ) + 1) / 64))
    with hg
  have hs : (∑ j : Fin 64, contourWeight j * Real.cos (k * contourAngle j)) =
      ∑ j ∈ Finset.range 64, g j := by
    rw [← Fin.sum_univ_eq_sum_range g]; rfl
  rw [hs]
  apply mem_sumIdx
  intro j _
  have := mem_smul (wq j) (cosTab_mem_any (k * (2 * j + 1)))
  refine mem_of_eq this ?_
  simp only [hg, wq, ConfigData.referenceDenominator]
  push_cast
  ring_nf

def bComp (n : ℕ) : QI :=
  smul ((1 + (1333 / 24233 : ℚ) ^ (n + 1)) / (n + 1 : ℚ)) (momI (n + 1))

theorem bComp_mem {n : ℕ} (hn : n < 48) : (bComp n).mem (bR n) := by
  unfold bComp bR
  have := mem_smul ((1 + (1333 / 24233 : ℚ) ^ (n + 1)) / (n + 1 : ℚ)) (momI_mem (k := n + 1) (by omega))
  convert this using 1
  unfold contourRatio
  push_cast
  ring

theorem bLit_ok : ∀ n < 48, QI.sub_le (bComp n) (bLit.getD n ⟨0, 0⟩) = true := by
  decide +kernel

theorem bLit_mem {n : ℕ} (hn : n < 48) : (bLit.getD n ⟨0, 0⟩).mem (bR n) :=
  QI.mem_of_sub_le (bLit_ok n hn) (bComp_mem hn)

