denominators with Boolean equality instead; theorem statements are unchanged. -/

def qBeq (a b : ℚ) : Bool := a.num == b.num && a.den == b.den

def qListBeq : List ℚ → List ℚ → Bool
  | [], [] => true
  | a :: p, b :: q => qBeq a b && qListBeq p q
  | _, _ => false

