/-- One low piece together with its certificate data. -/
def p0LowEntryOK :
    IntegerizationTables.AffinePiece × (ℕ × ℕ × ℕ × ℕ × (Fin 4 → Fin 4) × Bool) → Bool
  | (f, (A, B, C, Q, perm, k)) =>
      p0LowPieceOK ⟨f.lo, f.hi, A, B, C, Q, perm⟩ f.intercept f.slope k

/-- Every one of the 756 low pieces is certified (kernel evaluation of the finite
rational check). -/
theorem p0LowData_ok :
    p0LowCellData.length = IntegerizationTables.lowPieces.length ∧
      (IntegerizationTables.lowPieces.zip p0LowCellData).all p0LowEntryOK = true := by
  decide +kernel

end Li2Lean.P0.Integerization

#print axioms Li2Lean.P0.Integerization.p0LowData_ok
