import Li2Lean.Kit.ReceiptChain
import Mathlib.Algebra.BigOperators.Group.List.Defs

set_option maxRecDepth 10000
set_option maxHeartbeats 2000000

namespace Li2Lean.P0.ConfigData

open Li2Lean.F_L8

/-!
Exact rational source data from docs/6333, Appendix A, C-A.
The generated interval rows retain every endpoint and lower bound from
the source CSVs. The CSV row order is sorted by exact left endpoint so
the kernels can check an explicit gap-free chain.
-/

/-!
The recursive Boolean receipt lets each finite slice be checked by the
kernel without asking typeclass synthesis to elaborate a conjunction
whose depth grows with the whole slice. The sharding pattern is inspired
by the unrelated finite-certificate packaging in
`OAI.Algebra.AuslanderReiten.Cocycles.CocycleCertificate`; the checked
claims here are our exact rational interval endpoints and widths.
-/
def exactCellCheck (c : ReceiptCell) (left right : ℚ) : Bool :=
  decide (c.lo = left) && (decide (c.hi = right) && decide (c.lo ≤ c.hi))

def exactChainCheck : List ReceiptCell → ℚ → ℚ → Bool
  | [], _, _ => false
  | [c], left, right => exactCellCheck c left right
  | c :: d :: rest, left, right =>
      exactCellCheck c left d.lo && exactChainCheck (d :: rest) d.lo right

theorem exactCellCheck_sound {c : ReceiptCell} {left right : ℚ}
    (h : exactCellCheck c left right = true) :
    c.lo = left ∧ c.hi = right ∧ c.lo ≤ c.hi := by
  unfold exactCellCheck at h
  simpa only [Bool.and_eq_true, decide_eq_true_eq] using h

theorem exactChainCheck_sound {cells : List ReceiptCell} {left right : ℚ}
    (h : exactChainCheck cells left right = true) :
    Li2Lean.F_L8.ExactChain cells left right := by
  induction cells generalizing left right with
  | nil => simp [exactChainCheck] at h
  | cons c rest ih =>
      cases rest with
      | nil =>
          change exactCellCheck c left right = true at h
          rcases exactCellCheck_sound h with ⟨hleft, hright, hwidth⟩
          exact Li2Lean.F_L8.ExactChain.one c left right hleft hright hwidth
      | cons d tail =>
          change (exactCellCheck c left d.lo &&
            exactChainCheck (d :: tail) d.lo right) = true at h
          simp only [Bool.and_eq_true] at h
          rcases h with ⟨hc, htail⟩
          rcases exactCellCheck_sound hc with ⟨hlo, hhi, hwidth⟩
          exact Li2Lean.F_L8.ExactChain.more c d tail left right hlo hhi hwidth (ih htail)

